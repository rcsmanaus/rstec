#include <WiFi.h>
#include <WiFiManager.h> // Biblioteca para configuração WiFi via portal
#include <PubSubClient.h>
#include <WebServer.h>
#include <DHT.h>
#include <EEPROM.h>
#include <ArduinoJson.h>

// Definições dos pinos
#define DHTPIN 4
#define DHTTYPE DHT22
#define SMOKE_SENSOR_PIN 34
#define ACS712_PIN 35
#define RELAY1_PIN 16
#define RELAY2_PIN 17
#define RELAY3_PIN 18
#define RELAY4_PIN 19

// Configuração MQTT
// const char* mqtt_server = "broker.mqtt-dashboard.com";
const char* mqtt_server = "10.10.57.58";
const int mqtt_port = 1883;
const char* mqtt_user = "";
const char* mqtt_password = "";

// Variáveis globais
DHT dht(DHTPIN, DHTTYPE);
WiFiClient espClient;
PubSubClient client(espClient);
WebServer server(80);

// Estrutura para armazenar nomes dos relés
struct Config {
  char relay1_name[20];
  char relay2_name[20];
  char relay3_name[20];
  char relay4_name[20];
  char mqtt_topic[50];
};

Config config;

// Variáveis para medição de corrente
const float ACS712_SENSITIVITY = 0.1; // 100mV/A para o modelo 20A
const float QOV = 0.5 * 3.3; // Ponto quiescente de saída (VCC/2)
const int ADC_SCALE = 4095; // ESP32 ADC de 12 bits

void setup() {
  Serial.begin(115200);
  
  // Inicializa EEPROM
  EEPROM.begin(sizeof(Config));
  loadConfig();
  
  // Inicializa sensores e relés
  dht.begin();
  pinMode(SMOKE_SENSOR_PIN, INPUT);
  pinMode(RELAY1_PIN, OUTPUT);
  pinMode(RELAY2_PIN, OUTPUT);
  pinMode(RELAY3_PIN, OUTPUT);
  pinMode(RELAY4_PIN, OUTPUT);
  
  // Configura WiFiManager
  WiFiManager wifiManager;
  
  // Tenta conectar à rede WiFi salva ou abre portal de configuração
  if (!wifiManager.autoConnect("ESP32-Dbug")) {
    Serial.println("Falha ao conectar e timeout atingido");
    ESP.restart();
    delay(1000);
  }
  
  Serial.println("Conectado ao WiFi!");
  
  // Configura servidor web
  setupWebServer();
  
  // Configura MQTT
  client.setServer(mqtt_server, mqtt_port);
  client.setCallback(callback);
  
  // Inicia servidor
  server.begin();
}

void loop() {
  // Verifica conexão MQTT
  if (!client.connected()) {
    reconnectMQTT();
  }
  client.loop();
  
  // Manipula requisições do servidor web
  server.handleClient();
  
  // Publica dados dos sensores periodicamente
  static unsigned long lastPublish = 0;
  if (millis() - lastPublish > 10000) { // A cada 10 segundos
    publishSensorData();
    lastPublish = millis();
  }
}

void loadConfig() {
  EEPROM.get(0, config);
  
  // Se for a primeira vez, inicializa com valores padrão
  if (strlen(config.relay1_name) == 0) {
    strcpy(config.relay1_name, "Relé 1");
    strcpy(config.relay2_name, "Relé 2");
    strcpy(config.relay3_name, "Relé 3");
    strcpy(config.relay4_name, "Relé 4");
    strcpy(config.mqtt_topic, "esp32/iot");
    saveConfig();
  }
}

void saveConfig() {
  EEPROM.put(0, config);
  EEPROM.commit();
}

void setupWebServer() {
  // Página principal
  server.on("/", HTTP_GET, []() {
    String html = "<!DOCTYPE html><html><head><title>Configuração ESP32</title>";
    html += "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">";
    html += "<style>body{font-family:Arial,sans-serif;margin:20px;}";
    html += "input,button{margin:10px 0;padding:8px;width:100%;}";
    html += "button{background-color:#4CAF50;color:white;border:none;cursor:pointer;}";
    html += ".card{box-shadow:0 4px 8px 0 rgba(0,0,0,0.2);padding:16px;margin:10px 0;}</style></head>";
    html += "<body><h1>Configuração do ESP32</h1>";
    
    html += "<div class=\"card\"><h2>Configuração dos Relés</h2>";
    html += "<form action=\"/save\" method=\"POST\">";
    html += "Nome Relé 1: <input type=\"text\" name=\"relay1\" value=\"" + String(config.relay1_name) + "\"><br>";
    html += "Nome Relé 2: <input type=\"text\" name=\"relay2\" value=\"" + String(config.relay2_name) + "\"><br>";
    html += "Nome Relé 3: <input type=\"text\" name=\"relay3\" value=\"" + String(config.relay3_name) + "\"><br>";
    html += "Nome Relé 4: <input type=\"text\" name=\"relay4\" value=\"" + String(config.relay4_name) + "\"><br>";
    html += "Tópico MQTT: <input type=\"text\" name=\"mqtt_topic\" value=\"" + String(config.mqtt_topic) + "\"><br>";
    html += "<button type=\"submit\">Salvar Configuração</button></form></div>";
    
    html += "<div class=\"card\"><h2>Controle dos Relés</h2>";
    html += "<button onclick=\"controlRelay(1)\">Toggle " + String(config.relay1_name) + "</button>";
    html += "<button onclick=\"controlRelay(2)\">Toggle " + String(config.relay2_name) + "</button>";
    html += "<button onclick=\"controlRelay(3)\">Toggle " + String(config.relay3_name) + "</button>";
    html += "<button onclick=\"controlRelay(4)\">Toggle " + String(config.relay4_name) + "</button>";
    html += "<script>function controlRelay(relayNum){fetch('/relay?num='+relayNum);}</script></div>";
    
    html += "<div class=\"card\"><h2>Status dos Sensores</h2>";
    html += "<p>Temperatura: " + String(dht.readTemperature()) + " °C</p>";
    html += "<p>Umidade: " + String(dht.readHumidity()) + " %</p>";
    
    float current = getCurrent();
    html += "<p>Corrente: " + String(current) + " A</p>";
    
    int smokeValue = analogRead(SMOKE_SENSOR_PIN);
    html += "<p>Fumaça: " + String(smokeValue) + "</p></div>";
    
    html += "</body></html>";
    server.send(200, "text/html", html);
  });
  
  // Salvar configuração
  server.on("/save", HTTP_POST, []() {
    if (server.hasArg("relay1")) strncpy(config.relay1_name, server.arg("relay1").c_str(), sizeof(config.relay1_name));
    if (server.hasArg("relay2")) strncpy(config.relay2_name, server.arg("relay2").c_str(), sizeof(config.relay2_name));
    if (server.hasArg("relay3")) strncpy(config.relay3_name, server.arg("relay3").c_str(), sizeof(config.relay3_name));
    if (server.hasArg("relay4")) strncpy(config.relay4_name, server.arg("relay4").c_str(), sizeof(config.relay4_name));
    if (server.hasArg("mqtt_topic")) strncpy(config.mqtt_topic, server.arg("mqtt_topic").c_str(), sizeof(config.mqtt_topic));
    
    saveConfig();
    server.send(200, "text/plain", "Configuração salva! O ESP32 será reiniciado.");
    delay(1000);
    ESP.restart();
  });
  
  // Controle de relés
  server.on("/relay", HTTP_GET, []() {
    if (server.hasArg("num")) {
      int relayNum = server.arg("num").toInt();
      toggleRelay(relayNum);
    }
    server.send(200, "text/plain", "OK");
  });
}

void toggleRelay(int relayNum) {
  int pin;
  switch(relayNum) {
    case 1: pin = RELAY1_PIN; break;
    case 2: pin = RELAY2_PIN; break;
    case 3: pin = RELAY3_PIN; break;
    case 4: pin = RELAY4_PIN; break;
    default: return;
  }
  
  digitalWrite(pin, !digitalRead(pin));
  
  // Publica estado do relé via MQTT
  String topic = String(config.mqtt_topic) + "/relay" + String(relayNum) + "/state";
  client.publish(topic.c_str(), digitalRead(pin) ? "ON" : "OFF");
}

float getCurrent() {
  int adcValue = analogRead(ACS712_PIN);
  float voltage = (adcValue / (float)ADC_SCALE) * 3.3; // Converte para tensão
  float current = (voltage - QOV) / ACS712_SENSITIVITY; // Converte para corrente
  return current;
}

void publishSensorData() {
  // DHT22
  float temperature = dht.readTemperature();
  float humidity = dht.readHumidity();
  
  if (!isnan(temperature)) {
    String tempTopic = String(config.mqtt_topic) + "/temperature";
    client.publish(tempTopic.c_str(), String(temperature).c_str());
  }
  
  if (!isnan(humidity)) {
    String humTopic = String(config.mqtt_topic) + "/humidity";
    client.publish(humTopic.c_str(), String(humidity).c_str());
  }
  
  // ACS712
  float current = getCurrent();
  String currentTopic = String(config.mqtt_topic) + "/current";
  client.publish(currentTopic.c_str(), String(current).c_str());
  
  // Sensor de fumaça
  int smokeValue = analogRead(SMOKE_SENSOR_PIN);
  String smokeTopic = String(config.mqtt_topic) + "/smoke";
  client.publish(smokeTopic.c_str(), String(smokeValue).c_str());
}

void callback(char* topic, byte* payload, unsigned int length) {
  String message;
  for (int i = 0; i < length; i++) {
    message += (char)payload[i];
  }
  
  // Controle de relés via MQTT
  for (int i = 1; i <= 4; i++) {
    String relayTopic = String(config.mqtt_topic) + "/relay" + String(i) + "/command";
    if (String(topic) == relayTopic) {
      if (message == "ON") digitalWrite(getRelayPin(i), HIGH);
      else if (message == "OFF") digitalWrite(getRelayPin(i), LOW);
      else if (message == "TOGGLE") toggleRelay(i);
    }
  }
}

int getRelayPin(int relayNum) {
  switch(relayNum) {
    case 1: return RELAY1_PIN;
    case 2: return RELAY2_PIN;
    case 3: return RELAY3_PIN;
    case 4: return RELAY4_PIN;
    default: return -1;
  }
}

void reconnectMQTT() {
  while (!client.connected()) {
    Serial.println("Conectando ao MQTT...");
    String clientId = "ESP32Client-" + String(random(0xffff), HEX);
    
    if (client.connect(clientId.c_str(), mqtt_user, mqtt_password)) {
      Serial.println("Conectado ao MQTT!");
      
      // Inscreve nos tópicos de controle
      for (int i = 1; i <= 4; i++) {
        String topic = String(config.mqtt_topic) + "/relay" + String(i) + "/command";
        client.subscribe(topic.c_str());
      }
    } else {
      Serial.print("Falha, rc=");
      Serial.print(client.state());
      Serial.println(" Tentando novamente em 5 segundos...");
      delay(5000);
    }
  }
}
