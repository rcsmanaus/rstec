#include <WiFi.h>
#include <PubSubClient.h>
#include "DHT.h"

#define WIFI_SSID "DBUG"
#define WIFI_PASSWORD "dbugnaarea"
#define MQTT_SERVER "10.10.57.58"
#define MQTT_PORT 1883

#define DHTPIN 4
#define DHTTYPE DHT22

#define SMOKE_SENSOR_PIN 34
#define CURRENT_SENSOR_PIN 35

#define RELAY1 16
#define RELAY2 17
#define RELAY3 18
#define RELAY4 19

// IP fixo
IPAddress local_IP(192, 168, 70, 51);
IPAddress gateway(192, 168, 70, 1);
IPAddress subnet(255, 255, 255, 0);

DHT dht(DHTPIN, DHTTYPE);
WiFiClient espClient;
PubSubClient client(espClient);

void setup_wifi() {
  delay(10);
  Serial.println("Conectando ao Wi-Fi...");
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  int tentativas = 0;
  while (WiFi.status() != WL_CONNECTED && tentativas < 20) {
    delay(500);
    Serial.print(".");
    tentativas++;
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nWi-Fi conectado. IP: " + WiFi.localIP().toString());
  } else {
    Serial.println("\nFalha ao conectar no Wi-Fi.");
  }
}

void callback(char* topic, byte* payload, unsigned int length) {
  String msg;
  for (int i = 0; i < length; i++) {
    msg += (char)payload[i];
  }
  Serial.print("Comando recebido em [");
  Serial.print(topic);
  Serial.print("]: ");
  Serial.println(msg);

  if (String(topic) == "rele1") digitalWrite(RELAY1, msg == "ON" ? LOW : HIGH);
  if (String(topic) == "rele2") digitalWrite(RELAY2, msg == "ON" ? LOW : HIGH);
  if (String(topic) == "rele3") digitalWrite(RELAY3, msg == "ON" ? LOW : HIGH);
  if (String(topic) == "rele4") digitalWrite(RELAY4, msg == "ON" ? LOW : HIGH);
}

void reconnect() {
  while (!client.connected()) {
    Serial.print("Tentando conexão MQTT...");
    if (client.connect("DataCenterPalmeira")) {
      Serial.println("conectado.");
      client.subscribe("rele1");
      client.subscribe("rele2");
      client.subscribe("rele3");
      client.subscribe("rele4");
    } else {
      Serial.print("Falhou. rc=");
      Serial.print(client.state());
      Serial.println(" Tentando novamente em 5s...");
      delay(5000);
    }
  }
}

void setup() {
  Serial.begin(115200);
  pinMode(RELAY1, OUTPUT);
  pinMode(RELAY2, OUTPUT);
  pinMode(RELAY3, OUTPUT);
  pinMode(RELAY4, OUTPUT);

  // Relés desligados (ativo em LOW)
  digitalWrite(RELAY1, HIGH);
  digitalWrite(RELAY2, HIGH);
  digitalWrite(RELAY3, HIGH);
  digitalWrite(RELAY4, HIGH);

  dht.begin();
  setup_wifi();
  client.setServer(MQTT_SERVER, MQTT_PORT);
  client.setCallback(callback);
}

void loop() {
  if (!client.connected()) {
    reconnect();
  }
  client.loop();

  // Lê sensores
  float h = dht.readHumidity();
  float t = dht.readTemperature();
  int fumaça = analogRead(SMOKE_SENSOR_PIN);
  int corrente = analogRead(CURRENT_SENSOR_PIN);
   
   // Aciona RELÉ1 automaticamente se a temperatura for >= 32°C
  if (!isnan(t)) {
    if (t >= 32.0) {
      digitalWrite(RELAY1, LOW); // Liga (ativo em LOW)
    } else {
      digitalWrite(RELAY1, HIGH); // Desliga
    }
  }

  // Publica dados no MQTT
  client.publish("Palmeira_Temperatura", String(t).c_str(), true);
  client.publish("Palmeira_Umidade", String(h).c_str(), true);
  client.publish("Detector_fumaca", String(fumaça).c_str(), true);
  client.publish("Corrente_Eletrica", String(corrente).c_str(), true);

  delay(5000); // Aguarda 5s antes da próxima leitura
}
